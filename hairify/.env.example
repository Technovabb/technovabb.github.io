# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development

# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-before-going-live

# Where the SQLite file lives. Keep this on a persistent disk in production.
DATABASE_PATH=./data/hairify.db

# Public URL of the store, used in receipts and emails.
SITE_URL=http://localhost:3000

# Card payments. Leave PAYMENT_PROVIDER=manual to run with pay-on-delivery
# and in-store card only. Set to "firstatlantic" or "stripe" once the client's
# merchant account is live, then fill in the keys below.
PAYMENT_PROVIDER=manual
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# Transactional email (order receipts). Leave blank to log receipts to the
# console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=orders@hairifybb.com

# First admin account, created by `npm run setup`.
ADMIN_EMAIL=admin@hairifybb.com
ADMIN_PASSWORD=
